# Copie para .env e preencha. O .env nunca vai para o Git.

# Postgres. Em dev, o container do docker-compose atende nesta URL.
DATABASE_URL="postgresql://bookinguser:bookingpass@localhost:5432/booking?schema=public"

# Segredo de assinatura dos JWT. Em produção, gere um valor longo e aleatório:
# openssl rand -base64 48
JWT_SECRET="troque-este-valor"

# Porta da API.
PORT=3333

# Origem do front-end autorizada no CORS.
WEB_ORIGIN="http://localhost:3000"

# SMTP dos e-mails transacionais (convites e confirmação de reserva).
# Sem SMTP_HOST, o mailer cai numa conta de teste Ethereal e imprime no
# console um link de preview — nenhum e-mail é entregue de verdade.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="\"Time Flow\" <no-reply@seudominio.com>"
